APP_ENV=development
APP_NAME=Spravoshnik EPB
APP_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://spravoshnik:spravoshnik@127.0.0.1:5432/spravoshnik
TEST_DATABASE_URL=postgresql+psycopg://spravoshnik:spravoshnik@127.0.0.1:5433/spravoshnik_test
STORAGE_ROOT=./var/storage
LOG_LEVEL=INFO
WORKER_POLL_INTERVAL_SECONDS=2
SCHEDULER_TICK_SECONDS=30

SESSION_ABSOLUTE_TIMEOUT_MINUTES=720
SESSION_INACTIVITY_TIMEOUT_MINUTES=60
FAILED_LOGIN_LIMIT=5
FAILED_LOGIN_LOCK_MINUTES=15
SESSION_COOKIE_NAME=spravoshnik_session
SESSION_COOKIE_SECURE=false