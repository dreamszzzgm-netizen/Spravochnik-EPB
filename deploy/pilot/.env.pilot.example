# Copy this file to deploy/pilot/.env.pilot before first start.
# Never commit the real deploy/pilot/.env.pilot file.

PILOT_HTTP_PORT=3000
APP_VERSION=0.1.0
LOG_LEVEL=INFO

POSTGRES_USER=spravoshnik
POSTGRES_DB=spravoshnik
POSTGRES_PASSWORD=CHANGE_ME

# Keep DATABASE_URL synchronized with POSTGRES_* above.
# URL-encode special characters in the password before placing them in this URL.
DATABASE_URL=postgresql+psycopg://spravoshnik:CHANGE_ME@postgres:5432/spravoshnik

# Plain HTTP is allowed only for the initial trusted-LAN pilot.
# Change this to true when HTTPS/TLS is introduced.
SESSION_COOKIE_SECURE=false

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
WORKER_POLL_INTERVAL_SECONDS=2
SCHEDULER_INTERVAL_SECONDS=60
